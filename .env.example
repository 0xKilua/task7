# ---- Base de donnees ----
DATABASE_URL=postgresql://relook:relook@localhost:5432/relook

# ---- Cache / file d'attente des jobs de generation ----
REDIS_URL=redis://localhost:6379

# ---- Stockage objet (S3-compatible : MinIO en local, AWS S3 / Cloudflare R2 en prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=relook
S3_SECRET_ACCESS_KEY=relook123456
S3_BUCKET_PHOTOS=relook-photos
S3_FORCE_PATH_STYLE=true

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OAuth (optionnel, non actif tant que non configure)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# ---- Service de vision (segmentation, landmarks, recoloration, silhouette) ----
# Local, ne necessite aucune cle API. Voir services/vision.
VISION_SERVICE_URL=http://localhost:8100

# ---- Moteur IA generatif (changement de forme de coiffure, essayage vetements) ----
# Necessite un compte Replicate (https://replicate.com) et un token API.
# Sans cette variable, ces deux modules restent explicitement desactives
# dans l'interface (aucun resultat n'est simule ou invente).
REPLICATE_API_TOKEN=
AI_PROVIDER=replicate

# ---- Divers ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Duree de conservation par defaut des photos et simulations (jours) - RGPD
DATA_RETENTION_DAYS=90
