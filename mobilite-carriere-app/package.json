{
  "name": "mobilite-carriere-app",
  "version": "0.1.0",
  "private": true,
  "description": "Outil d'aide a l'accompagnement pour les conseillers mobilite-carriere de la fonction publique de l'Etat",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest-cli.ts",
    "dispositifs:importer": "tsx scripts/importer-dispositifs.ts",
    "sources:importer": "tsx scripts/importer-sources.ts",
    "sauvegarder": "node scripts/sauvegarder.mjs",
    "recherche:evaluer": "tsx scripts/evaluer-recherche.ts",
    "comptes:lister": "tsx scripts/comptes-cli.ts lister",
    "comptes:reinitialiser": "tsx scripts/comptes-cli.ts reinitialiser",
    "comptes:renommer": "tsx scripts/comptes-cli.ts renommer",
    "semantique:installer": "node scripts/installer-modele.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "better-sqlite3": "^13.0.3",
    "marked": "^18.0.13",
    "next": "^16.3.6",
    "onnxruntime-node": "1.30.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
